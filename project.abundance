        {
          "atomType": "Code",
          "x": 0.4,
          "y": 0.5,
          "uniqueID": "id-81",
          "ioValues": [
            {
              "name": "width",
              "ioValue": 9
            },
            {
              "name": "thickness",
              "ioValue": 0.25
            },
            {
              "name": "waveHeight",
              "ioValue": 1.5
            },
            {
              "name": "humpRadius",
              "ioValue": 1.75
            },
            {
              "name": "troughRadius",
              "ioValue": 2
            },
            {
              "name": "edgeAngle",
              "ioValue": 30
            }
          ],
          "interpreterVersion": 1,
          "code": "/**\n * Tile cross-section: symmetric profile with a circular hump in the centre, concave circular\n * troughs either side, rising to the edges. Offset normal to the curve by the tile thickness.\n * x runs across the tile width, y is height (trough bottoms at y = 0).\n */\nfunction run(\n  width: number = 9, // across the tile, inches\n  thickness: number = 0.25, // tile thickness\n  waveHeight: number = 1.5, // trough bottom to crest\n  humpRadius: number = 2, // radius of the centre hump (underside)\n  troughRadius: number = 2, // radius of the troughs (underside)\n  edgeAngle: number = 30, // how steeply the edges rise, degrees\n): Assembly {\n  // Symmetric profile, crest at x = width / 2. Out from the centre (distance d):\n  // convex circular hump (humpRadius) -> concave circular trough (troughRadius, bottom at y = 0)\n  // -> trough keeps curving up to edgeAngle -> straight run to the edge.\n  const half = width / 2;\n  const R = humpRadius, r = troughRadius;\n  if (waveHeight > R + r) throw new Error(\"waveHeight can be at most humpRadius + troughRadius\");\n  const theta = Math.acos(1 - waveHeight / (R + r)); // where hump meets trough\n  const phi = (edgeAngle * Math.PI) / 180;\n  const a1 = R * Math.sin(theta); // end of hump arc\n  const xc = (R + r) * Math.sin(theta); // trough bottom\n  const dE = xc + r * Math.sin(phi); // end of trough arc\n  if (dE > half) throw new Error(\"Profile wider than the tile: reduce the radii or edgeAngle\");\n  const yE = r - r * Math.cos(phi);\n\n  // Height and slope (dy/dd) at distance d from the centre\n  const at = (d: number): [number, number] => {\n    if (d <= a1) { const s = Math.sqrt(R * R - d * d); return [waveHeight - R + s, -d / s]; }\n    if (d <= dE) { const e = d - xc, s = Math.sqrt(r * r - e * e); return [r - s, e / s]; }\n    return [yE + Math.tan(phi) * (d - dE), Math.tan(phi)];\n  };\n\n  // Sample each piece, including its ends, then mirror to both halves\n  const ds: number[] = [];\n  const piece = (from: number, to: number, steps: number) => {\n    for (let i = ds.length ? 1 : 0; i <= steps; i++) ds.push(from + ((to - from) * i) / steps);\n  };\n  piece(0, a1, 8);\n  piece(a1, xc, 6);\n  piece(xc, dE, 4);\n  if (half - dE > 1e-6) piece(dE, half, 1);\n  const us = [...ds.slice(1).reverse().map((d) => half - d), ...ds.map((d) => half + d)];\n  const pts = us.map((u) => {\n    const [y, m] = at(Math.min(Math.abs(u - half), half));\n    return { u, y, slope: u < half ? -m : m };\n  });\n\n  // Underside along the profile, top side offset along the normal by the thickness\n  const n = pts.length - 1;\n  const top = pts.map(({ u, y, slope }) => {\n    const len = Math.sqrt(1 + slope * slope);\n    return [u - (slope / len) * thickness, y + thickness / len] as [number, number];\n  });\n  let pen = replicad.draw([pts[0].u, pts[0].y]);\n  for (let i = 1; i <= n; i++) {\n    pen = pen.smoothSplineTo([pts[i].u, pts[i].y], { startTangent: [1, pts[i - 1].slope], endTangent: [1, pts[i].slope] });\n  }\n  pen = pen.lineTo(top[n]);\n  for (let i = n - 1; i >= 0; i--) {\n    pen = pen.smoothSplineTo(top[i], { startTangent: [-1, -pts[i + 1].slope], endTangent: [-1, -pts[i].slope] });\n  }\n  return new Assembly({ geometry: pen.close() });\n}\n",
          "compiledCode": "\"use strict\";\n/**\n * Tile cross-section: symmetric profile with a circular hump in the centre, concave circular\n * troughs either side, rising to the edges. Offset normal to the curve by the tile thickness.\n * x runs across the tile width, y is height (trough bottoms at y = 0).\n */\nfunction run(width = 9, // across the tile, inches\nthickness = 0.25, // tile thickness\nwaveHeight = 1.5, // trough bottom to crest\nhumpRadius = 2, // radius of the centre hump (underside)\ntroughRadius = 2, // radius of the troughs (underside)\nedgeAngle = 30) {\n    // Symmetric profile, crest at x = width / 2. Out from the centre (distance d):\n    // convex circular hump (humpRadius) -> concave circular trough (troughRadius, bottom at y = 0)\n    // -> trough keeps curving up to edgeAngle -> straight run to the edge.\n    const half = width / 2;\n    const R = humpRadius, r = troughRadius;\n    if (waveHeight > R + r)\n        throw new Error(\"waveHeight can be at most humpRadius + troughRadius\");\n    const theta = Math.acos(1 - waveHeight / (R + r)); // where hump meets trough\n    const phi = (edgeAngle * Math.PI) / 180;\n    const a1 = R * Math.sin(theta); // end of hump arc\n    const xc = (R + r) * Math.sin(theta); // trough bottom\n    const dE = xc + r * Math.sin(phi); // end of trough arc\n    if (dE > half)\n        throw new Error(\"Profile wider than the tile: reduce the radii or edgeAngle\");\n    const yE = r - r * Math.cos(phi);\n    // Height and slope (dy/dd) at distance d from the centre\n    const at = (d) => {\n        if (d <= a1) {\n            const s = Math.sqrt(R * R - d * d);\n            return [waveHeight - R + s, -d / s];\n        }\n        if (d <= dE) {\n            const e = d - xc, s = Math.sqrt(r * r - e * e);\n            return [r - s, e / s];\n        }\n        return [yE + Math.tan(phi) * (d - dE), Math.tan(phi)];\n    };\n    // Sample each piece, including its ends, then mirror to both halves\n    const ds = [];\n    const piece = (from, to, steps) => {\n        for (let i = ds.length ? 1 : 0; i <= steps; i++)\n            ds.push(from + ((to - from) * i) / steps);\n    };\n    piece(0, a1, 8);\n    piece(a1, xc, 6);\n    piece(xc, dE, 4);\n    if (half - dE > 1e-6)\n        piece(dE, half, 1);\n    const us = [...ds.slice(1).reverse().map((d) => half - d), ...ds.map((d) => half + d)];\n    const pts = us.map((u) => {\n        const [y, m] = at(Math.min(Math.abs(u - half), half));\n        return { u, y, slope: u < half ? -m : m };\n    });\n    // Underside along the profile, top side offset along the normal by the thickness\n    const n = pts.length - 1;\n    const top = pts.map(({ u, y, slope }) => {\n        const len = Math.sqrt(1 + slope * slope);\n        return [u - (slope / len) * thickness, y + thickness / len];\n    });\n    let pen = replicad.draw([pts[0].u, pts[0].y]);\n    for (let i = 1; i <= n; i++) {\n        pen = pen.smoothSplineTo([pts[i].u, pts[i].y], { startTangent: [1, pts[i - 1].slope], endTangent: [1, pts[i].slope] });\n    }\n    pen = pen.lineTo(top[n]);\n    for (let i = n - 1; i >= 0; i--) {\n        pen = pen.smoothSplineTo(top[i], { startTangent: [-1, -pts[i + 1].slope], endTangent: [-1, -pts[i].slope] });\n    }\n    return new Assembly({ geometry: pen.close() });\n}\n"
        },
