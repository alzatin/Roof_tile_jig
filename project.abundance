          "interpreterVersion": 1,
          "code": "/**\n * Honeycomb air-hole cutter: vertical hex prisms in staggered rows, centered on the tile\n * footprint (x 0..width, y -length..0), kept edgeMargin in from every edge.\n * Subtract it from the Tile and the Slump Mold so their holes line up.\n */\nfunction run(\n  width: number = 9, // tile width (x)\n  length: number = 13, // tile length (y, from -length to 0)\n  cellSize: number = 0.375, // hex hole across the flats\n  wall: number = 0.375, // material left between neighbouring holes\n  edgeMargin: number = 0.375, // solid rim around the edge\n  zBottom: number = -3, // cutter runs from here...\n  zTop: number = 5, // ...to here, through both parts\n): Assembly {\n  const pitch = cellSize + wall; // centre spacing along a row\n  const r = cellSize / Math.sqrt(3); // hex corner radius (points along y)\n  const rowStep = (pitch * Math.sqrt(3)) / 2;\n\n  // One hex prism at the origin, points facing +/-y\n  let pen = replicad.draw([0, r]);\n  for (let k = 1; k < 6; k++) {\n    const a = Math.PI / 2 + (k * Math.PI) / 3;\n    pen = pen.lineTo([r * Math.cos(a), r * Math.sin(a)]);\n  }\n  const hex = pen.close().sketchOnPlane().extrude(zTop - zBottom).translate(0, 0, zBottom);\n\n  const xMin = edgeMargin + cellSize / 2, xMax = width - edgeMargin - cellSize / 2;\n  const yMin = -length + edgeMargin + r, yMax = -edgeMargin - r;\n  if (xMax < xMin || yMax < yMin) throw new Error(\"No room for holes: reduce cellSize or edgeMargin\");\n\n  const cols = Math.floor((xMax - xMin) / pitch) + 1;\n  const rows = Math.floor((yMax - yMin) / rowStep) + 1;\n  const x0 = (xMin + xMax) / 2 - ((cols - 1) * pitch) / 2;\n  const y0 = (yMin + yMax) / 2 - ((rows - 1) * rowStep) / 2;\n\n  const prisms = [];\n  for (let j = 0; j < rows; j++) {\n    const y = y0 + j * rowStep;\n    const shift = j % 2 ? pitch / 2 : 0;\n    for (let i = -1; i <= cols; i++) {\n      const x = x0 + shift + i * pitch;\n      if (x < xMin - 1e-6 || x > xMax + 1e-6) continue;\n      prisms.push(hex.clone().translate(x, y, 0));\n    }\n  }\n  console.log(`${prisms.length} holes`);\n  return new Assembly({ geometry: replicad.makeCompound(prisms) });\n}\n",
          "compiledCode": "\"use strict\";\n/**\n * Honeycomb air-hole cutter: vertical hex prisms in staggered rows, centered on the tile\n * footprint (x 0..width, y -length..0), kept edgeMargin in from every edge.\n * Subtract it from the Tile and the Slump Mold so their holes line up.\n */\nfunction run(width = 9, // tile width (x)\nlength = 13, // tile length (y, from -length to 0)\ncellSize = 0.375, // hex hole across the flats\nwall = 0.375, // material left between neighbouring holes\nedgeMargin = 0.375, // solid rim around the edge\nzBottom = -3, // cutter runs from here...\nzTop = 5) {\n    const pitch = cellSize + wall; // centre spacing along a row\n    const r = cellSize / Math.sqrt(3); // hex corner radius (points along y)\n    const rowStep = (pitch * Math.sqrt(3)) / 2;\n    // One hex prism at the origin, points facing +/-y\n    let pen = replicad.draw([0, r]);\n    for (let k = 1; k < 6; k++) {\n        const a = Math.PI / 2 + (k * Math.PI) / 3;\n        pen = pen.lineTo([r * Math.cos(a), r * Math.sin(a)]);\n    }\n    const hex = pen.close().sketchOnPlane().extrude(zTop - zBottom).translate(0, 0, zBottom);\n    const xMin = edgeMargin + cellSize / 2, xMax = width - edgeMargin - cellSize / 2;\n    const yMin = -length + edgeMargin + r, yMax = -edgeMargin - r;\n    if (xMax < xMin || yMax < yMin)\n        throw new Error(\"No room for holes: reduce cellSize or edgeMargin\");\n    const cols = Math.floor((xMax - xMin) / pitch) + 1;\n    const rows = Math.floor((yMax - yMin) / rowStep) + 1;\n    const x0 = (xMin + xMax) / 2 - ((cols - 1) * pitch) / 2;\n    const y0 = (yMin + yMax) / 2 - ((rows - 1) * rowStep) / 2;\n    const prisms = [];\n    for (let j = 0; j < rows; j++) {\n        const y = y0 + j * rowStep;\n        const shift = j % 2 ? pitch / 2 : 0;\n        for (let i = -1; i <= cols; i++) {\n            const x = x0 + shift + i * pitch;\n            if (x < xMin - 1e-6 || x > xMax + 1e-6)\n                continue;\n            prisms.push(hex.clone().translate(x, y, 0));\n        }\n    }\n    console.log(`${prisms.length} holes`);\n    return new Assembly({ geometry: replicad.makeCompound(prisms) });\n}\n"
        }
